{
  "manifestVersion": 7,
  "id": "com.transcriptpro.premiere-panel",
  "name": "TranscriptPRO",
  "version": "1.0.0",
  "main": "index.html",
  "host": [
    {
      "app": "PPRO",
      "minVersion": "25.0",
      "data": {
        "apiVersion": 2
      }
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "transcriptpro-panel",
      "label": { "default": "TranscriptPRO" },
      "minimumSize": { "width": 240, "height": 300 },
      "preferredSize": { "width": 300, "height": 500 },
      "maximumSize": { "width": 600, "height": 900 }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": ["ws://localhost:7890"],
      "webSocket": {
        "domains": ["ws://localhost:7890"]
      }
    }
  }
}
