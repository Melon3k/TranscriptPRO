{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-execute",
    "shell:allow-open",
    "shell:allow-spawn",
    "shell:allow-kill",
    "shell:allow-stdin-write",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "ffmpeg",    "cmd": "ffmpeg",    "args": true },
        { "name": "osascript", "cmd": "osascript", "args": true },
        { "name": "open",      "cmd": "open",      "args": true }
      ]
    },
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:scope-appdata-recursive",
    "fs:scope-temp-recursive",
    "updater:default",
    "process:default",
    "process:allow-restart"
  ]
}
