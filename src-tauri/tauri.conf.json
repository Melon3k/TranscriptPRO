{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TranscriptPRO",
  "version": "0.1.3",
  "identifier": "com.transcriptpro.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TranscriptPRO",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost; media-src 'self' asset: https://asset.localhost blob:; connect-src 'self' https://api.deepl.com https://api-free.deepl.com https://translation.googleapis.com https://huggingface.co https://github.com https://objects.githubusercontent.com https://*.githubusercontent.com",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["dmg", "nsis", "app"],
    "externalBin": ["binaries/ffmpeg", "binaries/llama-server"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/Melon3k/TranscriptPRO/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE4RkU3NkFFQkRGODQzRDEKUldUUlEvaTlybmIrR0IzclFoZDdlWWxQNDl6L2d3cENIRlFHMzRxYjAwWm4xSVJUZ09tNUczQlQK",
      "dialog": false
    }
  }
}
